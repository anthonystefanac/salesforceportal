      { id:"usiNumber", column:"bnsw_usinumber", type:"text", mono:true, required:true, sensitive:true, label:"Your USI (Universal Student Identifier)", showIf:function(a){return a.hasUSI==="Yes";} },
      { id:"usiPermission", column:"bnsw_usipermission", type:"checkboxes", bool:true, required:true, label:"USI permission", options:["I give permission for my USI to be verified with the USI Registry."] }
    ]},
    { title:"Your Details", sub:"Apprentice / trainee personal details.", fields:[
      { id:"firstName", column:"bnsw_firstname", type:"text", required:true, label:"Your First Name (Apprentice/Trainee)" },
      { id:"middleName", column:"bnsw_middlename", type:"text", label:"Your Middle Name(s) (Apprentice/Trainee)", optionalTag:true },
      { id:"lastName", column:"bnsw_lastname", type:"text", required:true, label:"Your Last Name (Apprentice/Trainee)" },
      { id:"previousName", column:"bnsw_previousname", type:"text", label:"Your Previous Name (Apprentice/Trainee)", optionalTag:true, hint:"If you have changed your name" },
      { id:"dob", column:"bnsw_dateofbirth", type:"date", required:true, sensitive:true, pastOnly:true, autocomplete:"bday", label:"Your Date of Birth (Apprentice/Trainee)", hint:"Pick a date, or type it as day / month / year" }
    ]},
    { title:"Home Address", sub:"Where you currently live.", fields:[
      { id:"homeStreet", column:"bnsw_homestreet", type:"text", required:true, label:"Your Home Number/Street" },
      { id:"homeSuburb", column:"bnsw_homesuburb", type:"text", required:true, label:"Your Home Suburb" },
      { id:"homePostcode", column:"bnsw_homepostcode", type:"text", mono:true, required:true, digits:4, autocomplete:"postal-code", label:"Your Home Postcode", hint:"4 digits, e.g. 2000" },
      { id:"homeState", column:"bnsw_homestate", type:"select", required:true, values:AU_STATE_VALUES, label:"Your Home State", options:AU_STATES }
