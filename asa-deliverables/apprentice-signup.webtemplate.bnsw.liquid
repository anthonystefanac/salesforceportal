      { id:"postalAddress", column:"bnsw_postaladdress", type:"text", required:true, label:"Your Postal Address", showIf:function(a){return a.postalSame==="No";} },
      { id:"postalSuburb", column:"bnsw_postalsuburb", type:"text", required:true, label:"Your Postal Suburb", showIf:function(a){return a.postalSame==="No";} },
      { id:"postalPostcode", column:"bnsw_postalpostcode", type:"text", mono:true, required:true, digits:4, label:"Your Postal Postcode", hint:"4 digits, e.g. 2000", showIf:function(a){return a.postalSame==="No";} }
    ]},
