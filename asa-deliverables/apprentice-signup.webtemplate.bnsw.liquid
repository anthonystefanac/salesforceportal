      { id:"schoolLevel", column:"bnsw_schoollevel", type:"select", required:true, label:"Currently at School — Which Level Are You In?",
        values:{"Yr 7":7,"Yr 8":8,"Yr 9":9,"Yr 10":10,"Yr 11":11,"Yr 12":12}, options:["Yr 7","Yr 8","Yr 9","Yr 10","Yr 11","Yr 12"], showIf:function(a){return a.stillAtSchool==="Yes";} },
      { id:"highestSchooling", column:"bnsw_highestschooling", type:"select", required:true, label:"Your Highest Level of Schooling Completed?",
        values:{"Year 10 or below":1,"Year 11":2,"Year 12":3,"Certificate I / II":4,"Certificate III / IV":5,"Other":6},
        options:["Year 10 or below","Year 11","Year 12","Certificate I / II","Certificate III / IV","Other"], showIf:function(a){return a.stillAtSchool==="No";} },
      { id:"monthCompleted", column:"bnsw_monthcompletedschool", type:"select", required:true, label:"Month Completed School", values:MONTH_VALUES, options:MONTHS, showIf:function(a){return a.stillAtSchool==="No";} },
      { id:"yearCompleted", column:"bnsw_yearcompletedschool", type:"text", mono:true, required:true, label:"Year Completed School", hint:"e.g. 2023", showIf:function(a){return a.stillAtSchool==="No";} }
    ]},
    { title:"Your Apprenticeship / Traineeship", sub:"Details of the role you're signing up for.", fields:[
