      { id:"startDate", column:"bnsw_apprenticeshipstartdate", type:"date", required:true, label:"Apprenticeship/Traineeship — Start Date", hint:"Pick a date, or type it as day / month / year" },
      { id:"jobTitle", column:"bnsw_jobtitle", type:"text", required:true, label:"Apprenticeship/Traineeship — Job Title" },
      { id:"qualification", column:"bnsw_qualification", type:"text", required:true, label:"Apprenticeship/Traineeship — Qualification" },
      { id:"commencedBefore", column:"bnsw_commencedbefore", type:"scale", bool:true, required:true, label:"Did Your Apprenticeship/Traineeship Commence Before Today?", options:["Yes","No"] }
    ]},
    { title:"Prior Employment", sub:"Any history with the same employer.", fields:[
      { id:"priorEmployer", column:"bnsw_previouslyworkedwithbusiness", type:"scale", bool:true, required:true, label:"Previously Worked With This Business?", options:["Yes","No"] },
      { id:"priorStart", column:"bnsw_priorworkstarted", type:"date", required:true, notFuture:true, label:"Previously Worked — Started", hint:"Pick a date, or type it as day / month / year", showIf:function(a){return a.priorEmployer==="Yes";} },
      { id:"priorEnd", column:"bnsw_priorworkended", type:"date", required:true, notFuture:true, notBefore:"priorStart", label:"Previously Worked — Ended", hint:"Pick a date, or type it as day / month / year", showIf:function(a){return a.priorEmployer==="Yes";} },
      { id:"priorEmploymentType", column:"bnsw_priorworkemploymenttype", type:"select", required:true, label:"Previously Worked — Employment Type",
        values:{"Full Time":1,"Part Time":2,"Casual":3}, options:["Full Time","Part Time","Casual"], showIf:function(a){return a.priorEmployer==="Yes";} },
      { id:"priorHours", column:"bnsw_priorworkhoursperweek", type:"text", number:true, label:"Average Hours per Week (if Part Time or Casual)",
        showIf:function(a){return a.priorEmployer==="Yes" && a.priorEmploymentType && a.priorEmploymentType!=="Full Time";} }
    ]},
    { title:"Workplace", sub:"Where you'll actually be working day to day.", fields:[
      { id:"workplaceName", column:"bnsw_workplacename", type:"text", required:true, label:"Workplace — Name" },
      { id:"workplaceAddress", column:"bnsw_workplaceaddress", type:"textarea", required:true, label:"Workplace — Full Address" }
    ]},
    { title:"Prior Study", sub:"Other qualifications or current study.", fields:[
      { id:"completedQual", column:"bnsw_completedqualification", type:"scale", bool:true, required:true, label:"Have You Completed a Qualification?", options:["Yes","No"] },
      { id:"qualDetails", column:"bnsw_qualificationdetails", type:"textarea", required:true, label:"Qualification Details", showIf:function(a){return a.completedQual==="Yes";} },
      { id:"qualStarted", column:"bnsw_qualificationstudystarted", type:"date", required:true, notFuture:true, label:"Completed Study — Started", hint:"Pick a date, or type it as day / month / year", showIf:function(a){return a.completedQual==="Yes";} },
      { id:"qualFinished", column:"bnsw_qualificationstudyfinished", type:"date", required:true, notFuture:true, notBefore:"qualStarted", label:"Completed Study — Finished", hint:"Pick a date, or type it as day / month / year", showIf:function(a){return a.completedQual==="Yes";} },
      { id:"currentlyStudying", column:"bnsw_currentlystudying", type:"scale", bool:true, required:true, label:"Currently Studying Now?", options:["Yes","No"] },
      { id:"studyName", column:"bnsw_currentstudyname", type:"text", required:true, label:"Currently Studying — Name and Title", showIf:function(a){return a.currentlyStudying==="Yes";} },
      { id:"studyStart", column:"bnsw_currentstudystartdate", type:"date", required:true, notFuture:true, label:"Currently Studying — Start Date", hint:"Pick a date, or type it as day / month / year", showIf:function(a){return a.currentlyStudying==="Yes";} }
    ]},
    { title:"Parent / Guardian", sub:"Required only if you're under 18.", fields:[
      { id:"under18", column:"bnsw_under18", type:"scale", bool:true, required:true, label:"Are You Under 18 Years of Age?", options:["Yes","No"] },
      { id:"guardianFirst", column:"bnsw_guardianfirstname", type:"text", required:true, sensitive:true, label:"Parent/Guardian — First Name", showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianLast", column:"bnsw_guardianlastname", type:"text", required:true, sensitive:true, label:"Parent/Guardian — Last Name", showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianAddress", column:"bnsw_guardianaddress", type:"text", required:true, sensitive:true, label:"Parent/Guardian — Address", showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianSuburb", column:"bnsw_guardiansuburb", type:"text", required:true, sensitive:true, label:"Parent/Guardian — Suburb", showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianState", column:"bnsw_guardianstate", type:"select", required:true, sensitive:true, label:"Parent/Guardian — State", values:AU_STATE_VALUES, options:AU_STATES, showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianPostcode", column:"bnsw_guardianpostcode", type:"text", mono:true, required:true, digits:4, hint:"4 digits, e.g. 2000", sensitive:true, label:"Parent/Guardian — Postcode", showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianMobile", column:"bnsw_guardianmobile", type:"tel", required:true, sensitive:true, digits:10, hint:"10 digits, e.g. 0412345678", label:"Parent/Guardian — Mobile Number", showIf:function(a){return a.under18==="Yes";} },
      { id:"guardianEmail", column:"bnsw_guardianemail", type:"email", required:true, sensitive:true, label:"Parent/Guardian — Email", showIf:function(a){return a.under18==="Yes";} }
    ]}
  ];

  var answers = {};
  var current = 0;

  // Pre-fill the tracking code from the email link (?trackingcode=...)
  try {
    var qs = new URLSearchParams(window.location.search);
    var tc = qs.get("trackingcode") || qs.get("code");
    if (tc) answers.trackingCode = tc.trim();
  } catch (e) { /* very old browser — applicant pastes the code manually */ }
  if (LOCKED_CODE) answers.trackingCode = LOCKED_CODE;
  // With a validated code from the link, skip the tracking-code step and show the code in the banner
  var TRACKING_COLUMN = STEPS[0].fields[0].column;
  if (LOCKED_CODE) {
    STEPS = STEPS.slice(1);
    document.getElementById("asaCodeChipValue").textContent = LOCKED_CODE;
    document.getElementById("asaCodeChip").hidden = false;
  }
  var card = document.getElementById("asaCard");
  var segmentsEl = document.getElementById("asaSegments");

  var REVIEW = STEPS.length;   // the "Review your details" page comes after the last section
  var returnToReview = false;  // true while editing a section from the review page
  var confirmed = false;       // "I confirm the details above are correct" on the review page
  for (var s=0; s<=STEPS.length; s++){
    var seg = document.createElement("div"); seg.className = "segment"; segmentsEl.appendChild(seg);
  }

  function cleanDigits(f, v){
    var c = String(v == null ? "" : v);
    if (f.type === "tel") c = c.replace(/^\s*\+\s*61\s*\(?0?\)?/, "0"); // +61 412... -> 0412...
    return c.replace(/\D/g, "").slice(0, f.digits);
  }

  // ---- Pre-fill -----------------------------------------------------------
  // The invite's Prefill Data column holds a JSON copy of the applicant's existing record
  // (written by the "prefill invite" flow), keyed by this table's column names. Each value is
  // turned back into the form's answer format. Consent checkboxes are never pre-filled.
  var original = {};   // field id -> pre-filled answer, to work out what the applicant changed
  var prefilled = false;
  function fromDataverse(f, v){
    if (v === null || v === undefined || v === "") return undefined;
    if (f.type === "checkboxes") return undefined;
    if (f.bool) return v === true || v === "true" ? "Yes" : (v === false || v === "false" ? "No" : undefined);
    if (f.values){ for (var k in f.values){ if (f.values[k] === Number(v)) return k; } return undefined; }
    if (f.type === "date") return parseISODate(String(v).slice(0, 10)) || undefined;
    if (f.type === "select") return f.options.indexOf(String(v)) > -1 ? String(v) : undefined;
    if (f.digits) return cleanDigits(f, v) || undefined;
    return String(v).trim() || undefined;
  }
  try {
    var pfEl = document.getElementById("asaPrefill");
    var pfText = pfEl ? pfEl.value.trim() : "";
    if (pfText){
      var pf = JSON.parse(pfText);
      STEPS.forEach(function(step){ step.fields.forEach(function(f){
        if (f.column === TRACKING_COLUMN) return;
        var v = fromDataverse(f, pf[f.column]);
        if (v !== undefined){ answers[f.id] = v; original[f.id] = v; prefilled = true; }
      }); });
    }
  } catch (e) { console.warn("Pre-fill data couldn't be read - starting with a blank form.", e); }
  if (prefilled) document.getElementById("asaPrefillNote").hidden = false;

  function isoToDMY(v){ var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || ""); return m ? m[3] + "/" + m[2] + "/" + m[1] : (v || ""); }
  function shown(f, v){
    if (v === undefined || v === null) return "";
    if (Array.isArray(v)) return f.bool ? (v.length ? "Agreed" : "") : v.join(", ");
    if (f.type === "date") return isoToDMY(v);
    return String(v).trim();
  }
  function isVisible(f){ return !f.showIf || f.showIf(answers); }

  // Plain-text summary of what the applicant changed, saved with the submission for staff.
  // Values of Sensitive fields are not written out - only that they changed.
  function changeSummary(){
    var changed = [], added = [], count = 0;
    STEPS.forEach(function(step){ step.fields.forEach(function(f){
      var label = f.label.replace(/\s+/g, " ");
      var was = shown(f, original[f.id]), now = isVisible(f) ? shown(f, answers[f.id]) : "";
      if (f.id in original){
        count++;
        if (was === now) return;
        if (!isVisible(f)) changed.push(label + ": removed (no longer applies)");
        else if (f.sensitive) changed.push(label + ": changed (sensitive - value not shown here)");
        else if (now === "") changed.push(label + ': "' + was + '" → removed');
        else changed.push(label + ': "' + was + '" → "' + now + '"');
      } else if (now !== "" && f.type !== "checkboxes" && f.column !== TRACKING_COLUMN){
        added.push(label);
      }
    }); });
    var out = "Pre-filled " + count + " field" + (count === 1 ? "" : "s") + ". ";
    out += changed.length ? "Applicant changed " + changed.length + "." : "Applicant made no changes to pre-filled answers.";
    if (changed.length) out += "\n\nChanged:\n- " + changed.join("\n- ");
    if (added.length) out += "\n\nFilled in by applicant (was blank):\n- " + added.join("\n- ");
    return out.length > 3900 ? out.substring(0, 3890) + "\n..." : out;
  }

  function visibleFields(step){ return step.fields.filter(function(f){ return !f.showIf || f.showIf(answers); }); }
  function tagHTML(f){ return f.sensitive ? '<span class="tag-sensitive">Sensitive</span>' : ""; }

  function fieldHTML(f){
    var reqClass = f.required ? "req" : "";
    var hint = f.hint ? '<span class="hint">' + f.hint + '</span>' : (f.optionalTag ? '<span class="hint">Optional</span>' : "");
    var warning = f.warning ? '<div class="warning">' + f.warning + '</div>' : "";
    var monoAttr = f.mono ? ' data-mono' : "";

    if (f.type === "text" || f.type === "email" || f.type === "tel" || f.type === "date"){
      var extra = "";
      if (f.digits) extra += ' inputmode="numeric" pattern="[0-9]*"'; // no maxlength: a pasted "0412 345 678" is trimmed to digits first
      if (f.autocomplete) extra += ' autocomplete="' + f.autocomplete + '"';
      if (f.type === "email") extra += ' autocapitalize="off" spellcheck="false"';
      if (f.type === "date") extra += ' min="1900-01-01" max="' + ((f.pastOnly || f.notFuture) ? todayISO() : "2100-12-31") + '"';
      return '<div class="field" data-field="' + f.id + '">' +
        '<label class="' + reqClass + '" for="' + f.id + '">' + f.label + tagHTML(f) + hint + '</label>' +
        '<input type="' + f.type + '" id="' + f.id + '"' + monoAttr + extra + ((f.id === "trackingCode" && LOCKED_CODE) ? ' readonly' : '') + ' value="' + esc(answers[f.id] || "") + '">' +
        warning + '<div class="error">Please fill in this field.</div></div>';
    }
    if (f.type === "select"){
      var opts = '<option value="" disabled ' + (!answers[f.id] ? "selected" : "") + '>Select one…</option>';
      f.options.forEach(function(o){ opts += '<option value="' + esc(o) + '" ' + (answers[f.id]===o?"selected":"") + '>' + esc(o) + '</option>'; });
      return '<div class="field" data-field="' + f.id + '">' +
        '<label class="' + reqClass + '" for="' + f.id + '">' + f.label + tagHTML(f) + hint + '</label>' +
        '<select id="' + f.id + '">' + opts + '</select>' +
        '<div class="error">Please select an option.</div></div>';
    }
    if (f.type === "textarea"){
      return '<div class="field" data-field="' + f.id + '">' +
        '<label class="' + reqClass + '" for="' + f.id + '">' + f.label + tagHTML(f) + hint + '</label>' +
        '<textarea id="' + f.id + '">' + esc(answers[f.id] || "") + '</textarea>' +
        '<div class="error">Please fill in this field.</div></div>';
    }
    if (f.type === "scale"){
      var choices = f.options.map(function(o){
        var checked = answers[f.id] === o ? "checked" : "";
        return '<label class="choice"><input type="radio" name="' + f.id + '" value="' + esc(o) + '" ' + checked + '><span><span class="dot"></span>' + esc(o) + '</span></label>';
      }).join("");
      return '<div class="field" data-field="' + f.id + '">' +
        '<fieldset><legend class="' + reqClass + '">' + f.label + tagHTML(f) + hint + '</legend>' +
        '<div class="scale-row">' + choices + '</div></fieldset>' +
        '<div class="error">Please choose one option.</div></div>';
    }
    if (f.type === "checkboxes"){
      var selected = answers[f.id] || [];
      var choices = f.options.map(function(o){
        var checked = selected.indexOf(o) > -1 ? "checked" : "";
        return '<label class="choice stack"><input type="checkbox" data-group="' + f.id + '" value="' + esc(o) + '" ' + checked + '><span><span class="box"></span>' + esc(o) + '</span></label>';
      }).join("");
      return '<div class="field" data-field="' + f.id + '">' +
        '<fieldset><legend class="' + reqClass + '">' + f.label + tagHTML(f) + hint + '</legend>' +
        '<div class="choice-row stack">' + choices + '</div></fieldset>' +
        '<div class="error">Please confirm this to continue.</div></div>';
    }
    return "";
  }

  function renderReview(){
    var html = '<h2>Review your details</h2><p class="step-sub">Please check everything below. Select <strong>Edit</strong> to change a section. When it\'s all correct, confirm and select <strong>Approve and submit</strong>.</p>';
    STEPS.forEach(function(step, i){
      var rows = visibleFields(step).map(function(f){
        var v = shown(f, answers[f.id]);
        var tag = (prefilled && (f.id in original) && shown(f, original[f.id]) !== v) ? '<span class="chg">Updated</span>' : "";
        return '<div class="rv-row"><dt>' + f.label + '</dt><dd>' + (v ? esc(v) : '<span class="rv-empty">Not provided</span>') + tag + '</dd></div>';
      }).join("");
      html += '<section class="rv-section"><div class="rv-head"><h3>' + step.title + '</h3>' +
        '<button type="button" class="rv-edit" data-step="' + i + '" aria-label="Edit ' + esc(step.title) + '">Edit</button></div>' +
        '<dl class="rv-list">' + rows + '</dl></section>';
    });
    html += '<div class="field rv-confirm" data-field="asaConfirm"><label class="choice stack"><input type="checkbox" id="asaConfirm"' + (confirmed ? ' checked' : '') + '>' +
      '<span><span class="box"></span>I confirm the details above are correct.</span></label>' +
      '<div class="error">Please confirm your details are correct.</div></div>';
    html += '<div class="actions">' +
      '<button type="button" class="btn-ghost" id="asaBack">Back</button>' +
      '<button type="button" class="btn-primary" id="asaNext">Approve and submit</button></div>';
    card.innerHTML = html;
    card.querySelectorAll(".rv-edit").forEach(function(b){
      b.addEventListener("click", function(){ current = +b.getAttribute("data-step"); returnToReview = true; render(); window.scrollTo(0, 0); });
    });
    document.getElementById("asaConfirm").addEventListener("change", function(e){
      confirmed = e.target.checked;
      if (confirmed) card.querySelector(".rv-confirm").classList.remove("invalid");
    });
    document.getElementById("asaBack").addEventListener("click", function(){ current = REVIEW - 1; returnToReview = false; render(); });
    document.getElementById("asaNext").addEventListener("click", function(){
      if (!confirmed){
        var c = card.querySelector(".rv-confirm"); c.classList.add("invalid");
        document.getElementById("asaConfirm").focus();
        return;
      }
      // Re-check every section (an edit can make questions in other sections apply)
      for (var i = 0; i < STEPS.length; i++){
        var bad = visibleFields(STEPS[i]).some(function(f){ return !!fieldError(f, answers[f.id]); });
        if (bad){ current = i; returnToReview = true; render(); validateStep(visibleFields(STEPS[i])); return; }
      }
      submit();
    });
    updateProgress();
  }

  function render(){
    if (current === REVIEW) return renderReview();
    var step = STEPS[current];
    var fields = visibleFields(step);
    var html = '<h2>' + step.title + '</h2><p class="step-sub">' + step.sub + '</p>';
    fields.forEach(function(f){ html += fieldHTML(f); });
    html += '<div class="actions">' +
      '<button type="button" class="btn-ghost" id="asaBack"' + (current===0?" disabled":"") + '>Back</button>' +
      '<button type="button" class="btn-primary" id="asaNext">' + (returnToReview ? "Save and review" : (current===STEPS.length-1 ? "Review" : "Next")) + '</button>' +
    '</div>';
    card.innerHTML = html;

    fields.forEach(function(f){
      if (f.type==="text"||f.type==="email"||f.type==="tel"||f.type==="textarea"||f.type==="date"){
        var inputEl = document.getElementById(f.id);
        var save = function(e){
          // Numbers-only fields: drop anything that isn't a digit as it's typed or pasted
          if (f.digits){
            var clean = cleanDigits(f, e.target.value);
            if (clean !== e.target.value) e.target.value = clean;
          }
          answers[e.target.id] = e.target.value;
        };
        inputEl.addEventListener("input", save);
        inputEl.addEventListener("change", save);
      }
      if (f.type==="select"){
        document.getElementById(f.id).addEventListener("change", function(e){ answers[e.target.id] = e.target.value; render(); });
      }
      if (f.type==="scale"){
        card.querySelectorAll('input[name="' + f.id + '"]').forEach(function(r){
          r.addEventListener("change", function(e){ answers[f.id] = e.target.value; render(); });
        });
      }
      if (f.type==="checkboxes"){
        var boxes = card.querySelectorAll('input[data-group="' + f.id + '"]');
        boxes.forEach(function(b){
          b.addEventListener("change", function(){
            var vals = Array.prototype.slice.call(boxes).filter(function(x){return x.checked;}).map(function(x){return x.value;});
            answers[f.id] = vals;
          });
        });
      }
    });

    document.getElementById("asaBack").addEventListener("click", function(){ if (current>0){ current--; render(); updateProgress(); } });
    document.getElementById("asaNext").addEventListener("click", function(){
      if (validateStep(fields)){
        if (returnToReview){ returnToReview = false; current = REVIEW; } else { current++; }
        render(); window.scrollTo(0, 0);
      }
    });
    updateProgress();
  }

  function validateStep(fields){
    var ok = true, firstBad = null;
    fields.forEach(function(f){
      var el = card.querySelector('[data-field="' + f.id + '"]');
      var msg = fieldError(f, answers[f.id]);
      el.classList.toggle("invalid", !!msg);
      if (msg){
        el.querySelector(".error").textContent = msg;
        ok = false;
        if (!firstBad) firstBad = el;
      }
    });
    if (firstBad){
      var input = firstBad.querySelector("input, select, textarea");
      if (input) input.focus();
    }
    return ok;
  }

  function updateProgress(){
    var segs = segmentsEl.children;
    for (var i=0;i<segs.length;i++){ segs[i].className = "segment" + (i<current ? " done" : (i===current ? " current" : "")); }
    document.getElementById("asaStepCaption").textContent = current === REVIEW ? "Review your details" : STEPS[current].title;
    document.getElementById("asaStepCount").textContent = current === REVIEW ? "Final check" : "Section " + (current+1) + " / " + STEPS.length;
  }

  // ---- Build the Dataverse payload and POST via Web API ----------------
  function buildPayload(){
    var payload = {};
    // Only send fields that are currently shown — answers to questions the
    // applicant later hid (e.g. a USI typed before switching to "No") are dropped.
    var visible = STEPS.reduce(function(acc, s){ return acc.concat(visibleFields(s)); }, []);
    if (LOCKED_CODE) payload[TRACKING_COLUMN] = LOCKED_CODE;
    visible.forEach(function(f){
      var raw = answers[f.id];
      if (typeof raw === "string") raw = raw.trim();
      if (raw === undefined || raw === null || raw === "") return;
      if (f.type === "checkboxes" && f.bool){ payload[f.column] = raw.length > 0; return; }
      if (f.bool){ payload[f.column] = raw === "Yes"; return; }
      if (f.values){ payload[f.column] = f.values[raw]; return; }
      if (f.date){ payload[f.column] = parseDMY(raw); return; }
      if (f.type === "date"){ payload[f.column] = parseISODate(raw); return; }
      if (f.digits){ payload[f.column] = raw.replace(/\s/g, ""); return; }
      if (f.number){ payload[f.column] = parseInt(raw, 10); return; }
      if (f.id === "usiNumber"){ payload[f.column] = raw.toUpperCase(); return; }
      payload[f.column] = raw;
    });
    // Link the record to the signed-in applicant (needed for the Contact-scoped Table Permission)
    if (LINK_CONTACT) payload[CONTACT_NAV + "@odata.bind"] = "/contacts(" + CONTACT_ID + ")";
    // Pre-filled forms also record what the applicant changed (columns added by Enable-Prefill.ps1;
    // only sent when there was pre-fill data, so the form still works without them)
    if (prefilled){ payload[PREFILLED_COLUMN] = true; payload[CHANGES_COLUMN] = changeSummary(); }
    return payload;
  }

  function submit(){
    var nextBtn = document.getElementById("asaNext");
    nextBtn.disabled = true;
    nextBtn.textContent = "Submitting…";

    asaApi.post("/_api/" + ENTITY_SET, JSON.stringify(buildPayload())).then(function(){
      showConfirmation(true);
    }, function(err){
      var status = (err && err.status) || 0;
      var text = (err && err.responseText) || "";
      var msg = text;
      try {
        var e = JSON.parse(text).error;
        msg = (e.code ? e.code + ": " : "") + (e.message || "");
        if (e.innererror && e.innererror.message) msg += " | " + e.innererror.message;
      } catch (ignore) { /* not JSON - keep raw text */ }
      if (!msg) msg = status ? "No response body" : ("Request did not reach the server - " + ((err && err.message) || "network problem"));
      console.error("Apprentice sign-up submit failed", status, text || err);
      showConfirmation(false, "HTTP " + status + " - " + msg.substring(0, 600));
    });
  }

  function showConfirmation(success, detail){
    for (var i=0;i<segmentsEl.children.length;i++){ segmentsEl.children[i].className = "segment done"; }
    document.getElementById("asaStepCaption").textContent = success ? "Complete" : "Error";
    document.getElementById("asaStepCount").textContent = "";

    if (success){
      card.innerHTML = '<div class="confirm">' +
        '<div class="mark2">&#10003;</div>' +
        '<h2>Thanks — your sign-up is recorded</h2>' +
        '<p>ASA has received your apprentice/trainee details' + (answers.firstName ? " for " + esc(answers.firstName) : "") + '.</p>' +
        '<p>A confirmation would normally be emailed to ' + esc(answers.email || "your address") + '.</p></div>';
    } else {
      card.innerHTML = '<div class="confirm is-error">' +
        '<div class="mark2">!</div>' +
        '<h2>Something went wrong</h2>' +
        '<p>Your details weren\'t saved. Please try Submit again, or call 1300 363 831 if the problem continues.</p>' +
        '<button type="button" class="restart" id="asaRetry">Try again</button>' +
        (detail ? '<details class="tech"><summary>Technical details (for support)</summary><pre>' + esc(detail) + '</pre></details>' : '') +
        '</div>';
      document.getElementById("asaRetry").addEventListener("click", function(){ render(); updateProgress(); });
    }
  }

  render();
})();
</script>
{% else %}
<div id="asa-signup-root">
<header class="asa-header">
  <div class="hdr-inner">
    <a class="brand" href="/" aria-label="Apprenticeship Support Australia">
      {% if asa_logo_url != '' %}<img class="brand-logo" src="{{ asa_logo_url | escape }}" alt="Apprenticeship Support Australia">{% else %}{{ asa_logo_svg }}{% endif %}
    </a>
    <a class="phone-btn" href="tel:1300363831" aria-label="Call 1300 363 831"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span class="ph-text">1300 363 831</span></a>
  </div>
</header>
<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">Apprentice &amp; trainee sign-up</p>
    <h1>Provide your details</h1>
    <span class="bar"></span>
    <p class="lede">Apprenticeship Support Australia (ASA) uses this page to collect your details for your apprenticeship or traineeship sign-up.</p>
  </div>
  <svg class="corner" viewBox="338 -2 101 98" aria-hidden="true"><path d="M341.087 49.8941L360.178 88.0973L393.302 49.5657L341.087 49.8941Z" fill="#F68D2E"/><path d="M436.781 50.4195L413.64 0L377.079 48.6681L377.517 49.5657L426.272 62.3731L436.781 50.4195Z" fill="#005E5D"/><path d="M341.24 49.8941L410.444 87.0246L436.781 50.4195L341.24 49.8941Z" fill="#FFB81C"/><path d="M419.551 93.0889L419.245 80.1502L412.743 88.8636L419.551 93.0889Z" fill="#279989"/><path d="M363.834 12.9169L341.087 49.8941L437 50.8136L363.834 12.9169Z" fill="#2DCCD3"/></svg>
</section>
<div class="wrap">
  <div class="msg-card">
  {% if code_state == 'used' %}
    <h2>Already submitted</h2>
    <p>This sign-up has already been submitted — thank you.</p>
    <p>If you need to change any of your details, please give us a call.</p>
  {% elsif code_state == 'cancelled' %}
    <h2>This sign-up link is no longer active</h2>
    <p>Please call us and we'll send you a new one.</p>
  {% elsif code_state == 'expired' %}
    <h2>This link has expired</h2>
    <p>Please call us and we'll send you a new sign-up link.</p>
  {% elsif code_state == 'invalid' %}
    <h2>We couldn't find this sign-up link</h2>
    <p>Please open the link exactly as it appears in your sign-up email. If it still doesn't work, give us a call.</p>
  {% else %}
    <h2>Use the link in your email</h2>
    <p>To provide your details, please open the personal sign-up link in the email ASA sent you. Each link is unique to you.</p>
  {% endif %}
    <p class="help"><a class="btn-teal" href="tel:1300363831">Call 1300 363 831</a></p>
  </div>
</div>
<footer class="asa-footer">
  <div class="ftr-inner">
    <a class="ftr-name" href="https://www.apprenticeshipsupport.com.au/" target="_blank" rel="noopener">Apprenticeship Support Australia</a>
    <span>For assistance call <a href="tel:1300363831">1300 363 831</a></span>
    {% if asa_privacy_url != '' %}<a href="{{ asa_privacy_url | escape }}" target="_blank" rel="noopener">Privacy policy</a>{% endif %}
  </div>
</footer>
</div>
{% endif %}
</body>
</html>
