<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sign Up — Apprentice or Trainee | Apprenticeship Support Australia</title>
{% if asa_use_webfont %}<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap">{% endif %}
<style>
  /* Colours and type matched to apprenticeshipsupport.com.au */
  :root{
    --asa-teal:#279989; --asa-teal-dark:#005E5D; --asa-cyan:#2DCCD3; --asa-orange:#F68D2E; --asa-amber:#FFB81C; --asa-amber-dark:#F2A500;
    --charcoal:#414042; --charcoal-band:#4A4A4A;
    --teal-dark:#414042; --teal:#279989; --gold:#FFB81C; --orange:#F68D2E;
    --paper:#F5F5F5; --surface:#FFFFFF; --line:#E0E0E0; --muted:#5E6366;
    --accent:#279989; --accent-strong:#005E5D; --accent-tint:#E4F3F1;
    --success:#2E7D5B; --success-tint:#DCEEE5; --danger:#B3261E; --danger-tint:#FBE7E5;
    --focus:#1F6FB2; --sensitive:#8A4B12; --sensitive-tint:#FDF0D9;
  }
  html, body{ margin:0; padding:0; background:var(--paper); }
  #asa-signup-root *{ box-sizing:border-box; }
  #asa-signup-root{ background:var(--paper); color:var(--charcoal); min-height:100vh; display:flex; flex-direction:column; font-family:"Figtree", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
  #asa-signup-root .wrap{ width:100%; max-width:760px; margin:0 auto; padding:28px 18px 56px; flex:1; }

  /* Header: logo left, teal phone button right (as on the ASA website) */
  #asa-signup-root .asa-header{ background:#fff; border-bottom:1px solid var(--line); }
  #asa-signup-root .hdr-inner{ max-width:1100px; margin:0 auto; padding:14px 18px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
  #asa-signup-root .brand{ display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--charcoal); min-width:0; }
  #asa-signup-root .brand-logo, #asa-signup-root .brand-svg{ display:block; height:52px; width:auto; max-width:100%; }
  #asa-signup-root .phone-btn{ flex:none; display:inline-flex; align-items:center; gap:8px; background:var(--asa-teal); color:#fff; text-decoration:none; font-weight:700; font-size:0.95rem; padding:10px 16px; border-radius:4px; }
  #asa-signup-root .phone-btn:hover{ background:var(--asa-teal-dark); }
  #asa-signup-root .phone-btn svg{ width:16px; height:16px; fill:currentColor; }

  /* Hero: big charcoal heading, yellow underline bar, triangle cluster */
  #asa-signup-root .hero{ position:relative; background:#fff; overflow:hidden; border-bottom:1px solid var(--line); }
  #asa-signup-root .hero-inner{ position:relative; z-index:1; max-width:760px; margin:0 auto; padding:34px 18px 38px; }
  #asa-signup-root .eyebrow{ margin:0 0 8px; font-size:0.8rem; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; color:var(--asa-teal); }
  #asa-signup-root .hero h1{ margin:0; font-size:clamp(1.7rem,5vw,2.5rem); font-weight:800; line-height:1.1; text-transform:uppercase; letter-spacing:0.01em; color:var(--charcoal); max-width:16ch; }
  #asa-signup-root .bar{ display:block; width:56px; height:5px; background:var(--asa-amber); border-radius:3px; margin:16px 0 16px; }
  #asa-signup-root .hero .lede{ margin:0; font-size:1.02rem; line-height:1.55; color:var(--muted); max-width:48ch; }
  #asa-signup-root .hero .date{ margin:10px 0 0; font-size:0.85rem; color:var(--muted); }
  #asa-signup-root .corner{ position:absolute; right:-6px; bottom:-4px; width:230px; height:auto; z-index:0; pointer-events:none; }
  #asa-signup-root .badge{ display:inline-flex; align-items:center; gap:5px; font-family:ui-monospace, "Cascadia Mono", Consolas, monospace; font-size:0.66rem; letter-spacing:0.07em; text-transform:uppercase; color:var(--accent-strong); background:var(--accent-tint); border:1px solid var(--accent); border-radius:999px; padding:4px 10px; margin-bottom:16px; }
  #asa-signup-root .progress-block{ margin-bottom:22px; }
  #asa-signup-root .segments{ display:grid; grid-auto-flow:column; gap:3px; }
  #asa-signup-root .segment{ height:6px; border-radius:3px; background:var(--line); }
  #asa-signup-root .segment.done{ background:var(--teal); }
  #asa-signup-root .segment.current{ background:var(--teal); opacity:0.5; }
  #asa-signup-root .progress-caption{ display:flex; justify-content:space-between; margin-top:8px; font-family:ui-monospace, "Cascadia Mono", Consolas, monospace; font-size:0.7rem; color:var(--muted); }
  #asa-signup-root .card{ background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:24px 22px 22px; }
  #asa-signup-root .card h2{ font-size:1.15rem; font-weight:700; color:var(--teal-dark); margin:0 0 4px; }
  #asa-signup-root .card .step-sub{ margin:0 0 20px; color:var(--muted); font-size:0.85rem; }
  #asa-signup-root .field{ margin-bottom:20px; }
