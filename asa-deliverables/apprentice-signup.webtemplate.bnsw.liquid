<body>

{%- comment -%} ---- Tracking code check (runs on the server) ---- {%- endcomment -%}
{%- assign code_state = 'missing' -%}
{%- assign code = request.params['trackingcode'] -%}
{%- if code == null or code == '' -%}{%- assign code = request.params['code'] -%}{%- endif -%}
{%- if code and code != '' -%}
  {%- if code.size > 60 -%}
    {%- assign code_state = 'invalid' -%}
  {%- else -%}
    {%- assign asa_cache_buster = now | date_add_minutes: 10 | date: 'yyyy-MM-ddTHH:mm:ss' -%}
    {%- fetchxml asa_invite_q -%}
    <fetch top="1">
      <entity name="bnsw_signupinvite">
        <attribute name="bnsw_trackingcode" />
        <attribute name="bnsw_invitestatus" />
        <attribute name="bnsw_expireson" />
        <attribute name="bnsw_prefilldata" />
        <filter type="and">
          <condition attribute="bnsw_trackingcode" operator="eq" value="{{ code | xml_escape }}" />
          <condition attribute="statecode" operator="eq" value="0" />
          {%- comment -%} Always true, but different every second, so the site can't reuse a
              cached answer from before an invite was cancelled, used or expired. {%- endcomment -%}
          <condition attribute="createdon" operator="le" value="{{ asa_cache_buster }}" />
        </filter>
      </entity>
    </fetch>
    {%- endfetchxml -%}
    {%- assign invite = asa_invite_q.results.entities | first -%}
    {%- if invite -%}
      {%- assign invite_status = invite.bnsw_invitestatus.value -%}
      {%- if invite_status == 2 -%}
        {%- assign code_state = 'used' -%}
      {%- elsif invite_status == 3 -%}
        {%- assign code_state = 'cancelled' -%}
      {%- else -%}
        {%- assign code_state = 'ok' -%}
        {%- if invite.bnsw_expireson -%}
          {%- assign exp_day = invite.bnsw_expireson | date: 'yyyyMMdd' | integer -%}
          {%- assign today_day = now | date: 'yyyyMMdd' | integer -%}
          {%- if exp_day < today_day -%}{%- assign code_state = 'expired' -%}{%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- else -%}
      {%- assign code_state = 'invalid' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{% if code_state == 'ok' %}
<div id="asa-signup-root">
<header class="asa-header">
  <div class="hdr-inner">
    <a class="brand" href="/" aria-label="Apprenticeship Support Australia">
      {% if asa_logo_url != '' %}<img class="brand-logo" src="{{ asa_logo_url | escape }}" alt="Apprenticeship Support Australia">{% else %}{{ asa_logo_svg }}{% endif %}
    </a>
    <a class="phone-btn" href="tel:1300363831" aria-label="Call 1300 363 831"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/></svg><span class="ph-text">1300 363 831</span></a>
  </div>
</header>
<section class="hero">
  <div class="hero-inner">
    <p class="eyebrow">Apprentice &amp; trainee sign-up</p>
    <h1>Provide your details</h1>
    <span class="bar"></span>
    <p class="lede">Use this form to give Apprenticeship Support Australia (ASA) your details, ready for your sign-up. It takes about 10–15 minutes.</p>
    <p class="date" id="asaTodayDate"></p>
    <p class="code-chip" id="asaCodeChip" hidden>Your sign-up code <strong id="asaCodeChipValue"></strong></p>
  </div>
  <svg class="corner" viewBox="338 -2 101 98" aria-hidden="true"><path d="M341.087 49.8941L360.178 88.0973L393.302 49.5657L341.087 49.8941Z" fill="#F68D2E"/><path d="M436.781 50.4195L413.64 0L377.079 48.6681L377.517 49.5657L426.272 62.3731L436.781 50.4195Z" fill="#005E5D"/><path d="M341.24 49.8941L410.444 87.0246L436.781 50.4195L341.24 49.8941Z" fill="#FFB81C"/><path d="M419.551 93.0889L419.245 80.1502L412.743 88.8636L419.551 93.0889Z" fill="#279989"/><path d="M363.834 12.9169L341.087 49.8941L437 50.8136L363.834 12.9169Z" fill="#2DCCD3"/></svg>
</section>
<div class="wrap">

  <div class="prefill-note" id="asaPrefillNote" hidden>
    <strong>We've filled in the details we already have.</strong>
    Please check each section, correct anything that's wrong and complete any blanks. You'll see everything again before you submit.
  </div>
  <textarea id="asaPrefill" hidden aria-hidden="true">{{ invite.bnsw_prefilldata | escape }}</textarea>

  <div class="progress-block">
    <div class="segments" id="asaSegments"></div>
    <div class="progress-caption">
      <span id="asaStepCaption"></span>
      <span id="asaStepCount"></span>
    </div>
  </div>

  <div class="card" id="asaCard"></div>

  <div class="note">
    Fields tagged <span class="tag-sensitive">Sensitive</span> contain personal information that is only visible to authorised ASA staff.
  </div>
</div>
<footer class="asa-footer">
  <div class="ftr-inner">
    <a class="ftr-name" href="https://www.apprenticeshipsupport.com.au/" target="_blank" rel="noopener">Apprenticeship Support Australia</a>
    <span>For assistance call <a href="tel:1300363831">1300 363 831</a></span>
    {% if asa_privacy_url != '' %}<a href="{{ asa_privacy_url | escape }}" target="_blank" rel="noopener">Privacy policy</a>{% endif %}
  </div>
</footer>
</div>

<script>
// ---- Power Pages Web API helper (self-contained) ----------------------
// Works with or without the site's header/footer: it does not need jQuery or the
// Power Pages "shell" script. It fetches the anti-forgery token from the site's
// standard token endpoint and sends it with the request.
var asaApi = {
  getToken: function(){
    return fetch("/_layout/tokenhtml?_=" + Date.now(), { credentials: "same-origin", cache: "no-store" })
      .then(function(r){ return r.text(); })
      .then(function(html){
        var m = html.match(/value="([^"]+)"/);
        if (!m) throw new Error("Could not get a security token from the site");
        return m[1];
      });
  },
  post: function(url, body){
    return asaApi.getToken().then(function(token){
      return fetch(url, {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
          "__RequestVerificationToken": token
        },
        body: body
      });
    }).then(function(res){
      if (res.ok) return res;
      return res.text().then(function(t){
        var err = new Error("HTTP " + res.status); err.status = res.status; err.responseText = t; throw err;
      });
    });
  }
};

(function(){
  document.getElementById("asaTodayDate").textContent = new Date().toLocaleDateString("en-AU", { day:"numeric", month:"short", year:"numeric" });

  // ---- Dataverse wiring -----------------------------------------------
  var ENTITY_SET = "bnsw_apprenticesignups"; // plural logical name — verify in Table properties
  var CONTACT_NAV = "bnsw_Contact";          // Contact lookup navigation property (schema name, case-sensitive)
  var CONTACT_ID = "{{ user.id }}";          // signed-in portal user's Contact id, injected by Liquid
  var LOCKED_CODE = "{{ invite.bnsw_trackingcode | escape }}"; // validated on the server; shown read-only
  var PREFILLED_COLUMN = "bnsw_prefilled";   // Yes/No: the form started from pre-filled data
  var CHANGES_COLUMN = "bnsw_prefillchanges"; // text: what the applicant changed from the pre-filled data
  var LINK_CONTACT = false;                  // true = also set the Applicant (Contact) lookup on save.
                                             // Needs Contact-scope permissions that Power Pages refused
                                             // in testing (90040106) - leave false with the Global,
                                             // Create-only table permission.
  var AU_STATE_VALUES = { "NSW":1,"VIC":2,"QLD":3,"WA":4,"SA":5,"TAS":6,"ACT":7,"NT":8 };
  var MONTH_VALUES = { "January":1,"February":2,"March":3,"April":4,"May":5,"June":6,"July":7,"August":8,"September":9,"October":10,"November":11,"December":12 };

  function parseDMY(v){
    // "dd/mm/yyyy" -> "yyyy-mm-dd" for Dataverse Date Only columns
    if (!v) return null;
    var m = v.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if (!m) return null;
    var d = +m[1], mo = +m[2], y = +m[3];
    var dt = new Date(Date.UTC(y, mo - 1, d));
    if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return null; // e.g. 31/02
    if (y < 1900 || y > 2100) return null;
    return m[3] + "-" + m[2].padStart(2,"0") + "-" + m[1].padStart(2,"0");
  }

  // Date picker values arrive as "yyyy-mm-dd". Returns the same string if it's a real date, else null.
  function parseISODate(v){
    var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v || "");
    if (!m) return null;
    var y = +m[1], mo = +m[2], d = +m[3];
    var dt = new Date(Date.UTC(y, mo - 1, d));
    if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) return null;
    if (y < 1900 || y > 2100) return null;
    return v;
  }
  function todayISO(){
    var t = new Date();
    return t.getFullYear() + "-" + String(t.getMonth() + 1).padStart(2, "0") + "-" + String(t.getDate()).padStart(2, "0");
  }

  function esc(v){
    return String(v == null ? "" : v).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
  }

  // ---- Format rules (checked in addition to "required") ----------------
  // Keyed by field id. Each returns an error message, or "" when valid.
  function postcodeRule(v){ return /^\d{4}$/.test(v) ? "" : "Enter a 4-digit postcode."; }
  function phoneRule(v){ return /^0\d{9}$/.test(v.replace(/\s/g, "")) ? "" : "Enter a 10-digit mobile number starting with 0 (numbers only), e.g. 0412345678."; }
  function emailRule(v){
    v = v.trim();
    return /^[A-Za-z0-9.!#$%&'*+\/=?^_`{|}~-]+@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*\.[A-Za-z]{2,}$/.test(v) && v.indexOf("..") === -1
      ? "" : "Enter a valid email address, e.g. name@example.com.";
  }
  var RULES = {
    usiNumber: function(v){
      // USI: 10 characters, letters and digits excluding I, O, 0 and 1
      return /^[2-9A-HJ-NP-Z]{10}$/i.test(v.trim()) ? "" : "A USI is 10 letters/numbers (it never contains I, O, 0 or 1).";
    },
    homePostcode: postcodeRule, postalPostcode: postcodeRule, guardianPostcode: postcodeRule,
    mobile: phoneRule, guardianMobile: phoneRule,
    email: emailRule, guardianEmail: emailRule,
    yearCompleted: function(v){
      var y = parseInt(v, 10), now = new Date().getFullYear();
      return /^\d{4}$/.test(v.trim()) && y >= 1950 && y <= now ? "" : "Enter a 4-digit year, e.g. 2023.";
    },
    priorHours: function(v){
      var n = Number(v);
      return /^\d{1,3}$/.test(v.trim()) && n >= 1 && n <= 168 ? "" : "Enter a whole number of hours between 1 and 168.";
    }
  };
  function fieldError(f, raw){
    var v = raw == null ? "" : raw.toString();
    var empty = f.type === "checkboxes" ? (raw || []).length === 0 : v.trim() === "";
    if (empty) return f.required ? defaultMsg(f) : "";
    if (f.date && !parseDMY(v.trim())) return "Enter a real date as dd/mm/yyyy.";
    if (f.type === "date"){
      if (!parseISODate(v)) return "Choose a date from the calendar, or enter a complete date.";
      if (f.pastOnly && v >= todayISO()) return "Your date of birth must be in the past.";
      if (f.notFuture && v > todayISO()) return "This date can't be in the future.";
      if (f.notBefore && parseISODate(answers[f.notBefore]) && v < answers[f.notBefore]) return "This date can't be before the start date.";
    }
    if (f.digits && !new RegExp("^\\d{" + f.digits + "}$").test(v.replace(/\s/g, ""))) return RULES[f.id] ? RULES[f.id](v) : "Enter " + f.digits + " digits (numbers only).";
    if (RULES[f.id]) return RULES[f.id](v);
    return "";
  }
  function defaultMsg(f){
    if (f.type === "select") return "Please select an option.";
    if (f.type === "scale") return "Please choose one option.";
    if (f.type === "checkboxes") return "Please confirm this to continue.";
    return "Please fill in this field.";
  }

  var AU_STATES = Object.keys(AU_STATE_VALUES);
  var MONTHS = Object.keys(MONTH_VALUES);

  // ---- Step / field definitions ----------------------------------------
  // column = Dataverse logical name · bool = Two Options · values = Choice map · date = Date Only
  var STEPS = [
    { title:"Sign Up Tracking Code", sub:"Select Next to continue.", fields:[
