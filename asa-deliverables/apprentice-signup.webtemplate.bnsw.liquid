      { id:"citizenship", column:"bnsw_citizenship", type:"select", required:true, sensitive:true, label:"Your Citizenship", values:{"Australian Citizen":1,"New Zealand Citizen":2,"Permanent Resident":3,"Other (visa required)":4}, options:["Australian Citizen","New Zealand Citizen","Permanent Resident","Other (visa required)"] },
      { id:"visaDetails", column:"bnsw_visadetails", type:"textarea", required:true, sensitive:true, label:"Visa Details",
        hint:"If you are not an Australian or New Zealand citizen and have been in Australia for more than 6 months, you need to provide your visa details.",
        showIf:function(a){return a.citizenship==="Other (visa required)";} },
      { id:"countryOfBirth", column:"bnsw_countryofbirth", type:"text", required:true, label:"Your Country of Birth" },
      { id:"languageAtHome", column:"bnsw_languageathome", type:"select", required:true, label:"Language Spoken at Home", values:{"English Only":1,"Language other than English":2}, options:["English Only","Language other than English"] },
      { id:"indigenous", column:"bnsw_indigenousstatus", type:"select", required:true, sensitive:true, label:"Are You Aboriginal or Torres Strait Islander?",
        values:{"No":1,"Aboriginal":2,"Torres Strait Islander":3,"Both Aboriginal and Torres Strait Islander":4,"Prefer not to say":5},
        options:["No","Aboriginal","Torres Strait Islander","Both Aboriginal and Torres Strait Islander","Prefer not to say"] },
      { id:"disability", column:"bnsw_disability", type:"scale", bool:true, required:true, sensitive:true, label:"Do You Have a Disability, Impairment or Long Term Condition?", options:["Yes","No"] }
    ]},
    { title:"Schooling", sub:"Your education background.", fields:[
