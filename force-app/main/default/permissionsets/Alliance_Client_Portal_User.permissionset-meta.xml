<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Alliance Client Portal User</label>
    <description>Assign to every Experience Cloud client contact using the Alliance Client Portal. Grants MVP-scoped access: create/read staffing requests, read status, read-only invoices, create support cases. Does not grant delete on any object.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <classAccesses>
        <apexClass>PortalDashboardController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>StaffingRequestController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FacilityController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>InvoiceController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SupportRequestController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PortalUserBadgeController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <objectPermissions>
        <object>Account</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Facility__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Ward__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Staffing_Request__c</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Invoice__c</object>
        <allowRead>true</allowRead>
        <allowCreate>false</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Case</object>
        <allowRead>true</allowRead>
        <allowCreate>true</allowCreate>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Facility__c: read-only, used to populate the facility picker.
         Facility_Type__c is a required field - like Master-Detail fields,
         required fields aren't subject to FLS at all, so it needs no entry. -->
    <fieldPermissions>
        <field>Facility__c.Address_Street__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Facility__c.Address_Suburb__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Facility__c.Address_State__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Facility__c.Address_Postcode__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Facility__c.Active__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <!-- Facility__c.Account__c is Master-Detail - not subject to FLS at all,
         Salesforce always exposes it wherever Facility__c itself is readable. -->

    <!-- Ward__c: read-only, used to populate the ward picker. Ward__c.Facility__c
         is Master-Detail, so (like Facility__c.Account__c) it needs no FLS entry
         even though the picker filters on it. -->

    <!-- Staffing_Request__c: creatable fields are what the Request Staff form submits;
         Status__c, Broadcasted_Date__c, Last_Status_Update__c and Cancellation_Requested__c
         are read-only to the portal - only the Workforce Management integration
         (server-side Apex) or an allocator ever changes them. Requested_By_Contact__c
         and External_Demand_Id__c are intentionally NOT granted: both are set only by
         trusted server-side Apex and must never be client-writable or client-readable. -->
    <!-- Staffing_Request__c.Facility__c is Master-Detail - not subject to FLS,
         the form's facility picker still populates it fine without an entry here.
         Role__c, Shift_Date__c, Start_Time__c, End_Time__c, Quantity__c, Priority__c
         and Status__c are all required fields - also not subject to FLS, so none
         of them get an entry either, even though the form submits most of them. -->
    <fieldPermissions>
        <field>Staffing_Request__c.Ward__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Staffing_Request__c.Specialty__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Staffing_Request__c.Notes__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Staffing_Request__c.Broadcasted_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Staffing_Request__c.Last_Status_Update__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Staffing_Request__c.Cancellation_Requested__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- Invoice__c: read-only in Phase 1. External_Invoice_Id__c is NOT granted.
         Account__c (Master-Detail) and Invoice_Number__c/Invoice_Date__c/Amount__c/
         Status__c (all required) aren't subject to FLS - only Due_Date__c is
         optional and needs an actual entry. -->
    <fieldPermissions>
        <field>Invoice__c.Due_Date__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>

    <!-- Case: used by the Support/Query screen. Subject/Description are the
         standard fields the record-edit form submits alongside our two custom ones.
         Status is a required standard field - not subject to FLS, no entry needed. -->
    <fieldPermissions>
        <field>Case.Subject</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Description</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Portal_Request_Type__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Case.Related_Staffing_Request__c</field>
        <readable>true</readable>
        <editable>true</editable>
    </fieldPermissions>

    <tabSettings>
        <tab>Staffing_Request__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Invoice__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Facility__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
    <tabSettings>
        <tab>Ward__c</tab>
        <visibility>Visible</visibility>
    </tabSettings>
</PermissionSet>
